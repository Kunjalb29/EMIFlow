generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  brand       String
  description String?
  category    String    @default("Smartphones")
  rating      Float     @default(0)
  reviewCount Int       @default(0)
  specs       Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]
  reviews     Review[]

  @@index([brand])
  @@index([slug])
}

model Variant {
  id           String         @id @default(cuid())
  productId    String
  color        String
  colorHex     String         @default("#000000")
  storage      String
  mrp          Float
  sellingPrice Float
  cashback     Float          @default(0)
  stock        Int            @default(0)
  sku          String         @unique
  isDefault    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  emiPlans     EmiPlan[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id        String  @id @default(cuid())
  variantId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([sortOrder])
}

model EmiPlan {
  id            String   @id @default(cuid())
  variantId     String
  tenureMonths  Int
  monthlyAmount Float
  interestRate  Float    @default(0)
  totalAmount   Float
  cashback      Float    @default(0)
  processingFee Float    @default(0)
  isPopular     Boolean  @default(false)
  createdAt     DateTime @default(now())
  variant       Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([tenureMonths])
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  reviewerName  String
  rating        Float
  comment       String
  verifiedBuyer Boolean  @default(false)
  variantInfo   String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([rating])
}
